# Domínio final do site, SEM barra no fim.
# O Vite injeta este valor no index.html (sintaxe %VITE_SITE_URL%) nas URLs
# absolutas: canonical, og:url, og:image, twitter:image e o JSON-LD.
# scripts/generate-sitemap.mjs usa o mesmo valor no sitemap.xml e no robots.txt.
# Troque aqui antes do deploy — é o único lugar.
VITE_SITE_URL=https://otaviocruz.com.br
